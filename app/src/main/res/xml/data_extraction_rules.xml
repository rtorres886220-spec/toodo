<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="anchor_database" />
        <include domain="file" path="shared_attachments/" />
        <include domain="sharedpref" path="anchor_user_settings.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="anchor_database" />
        <include domain="file" path="shared_attachments/" />
        <include domain="sharedpref" path="anchor_user_settings.xml" />
    </device-transfer>
</data-extraction-rules>
